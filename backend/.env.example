# Copy this file to `.env` and fill in values. `.env` is git-ignored — never commit real keys.

# Port the API listens on
PORT=5000

# Groq API key (https://console.groq.com/keys). Optional:
# without it every AI request uses the rule-based fallback.
GROQ_API_KEY=

# Model used for triage and resource planning
GROQ_MODEL=llama-3.3-70b-versatile

# Abort an LLM call after this many milliseconds and fall back to rules
LLM_TIMEOUT_MS=15000

# Where reports, alerts and plans are persisted (JSON file)
DATA_FILE=./data/rhin.json

# Seed demo reports when the data file is empty (true/false)
SEED_DEMO_DATA=true

# Comma-separated origins allowed to call the API (leave empty when the API serves the frontend itself)
CORS_ORIGINS=http://localhost:8080

# Folder with the built frontend (vite build output). Served by the API when it exists,
# so production runs as a single service. Relative to the backend folder.
STATIC_DIR=../dist
